        "# ==============================\n",
        "# SOAL P5 - ANALISIS DATA CPNS\n",
        "# ==============================\n",
        "\n",
        "# import library\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.linear_model import LogisticRegression\n",
        "from sklearn.metrics import confusion_matrix, accuracy_score\n",
        "\n",
        "# ==============================\n",
        "# LOAD DATA\n",
        "# ==============================\n",
        "\n",
        "df = pd.read_csv('/content/testcpns.csv')\n",
        "\n",
        "# tampilkan data\n",
        "print(df.head())\n",
        "\n",
        "# ==============================\n",
        "# A. RINGKASAN DATA\n",
        "# ==============================\n",
        "\n",
        "print(\"\\nINFO DATA\")\n",
        "print(df.info())\n",
        "\n",
        "print(\"\\nSTATISTIK DESKRIPTIF\")\n",
        "print(df.describe())\n",
        "\n",
        "print(\"\\nMISSING VALUE\")\n",
        "print(df.isnull().sum())\n",
        "\n",
        "# ==============================\n",
        "# B. SCATTER PLOT\n",
        "# ==============================\n",
        "\n",
        "sns.pairplot(df, hue='diterima')\n",
        "plt.show()\n",
        "\n",
        "print(\"\"\"\n",
        "Analisis:\n",
        "Visualisasi menunjukkan bahwa peserta dengan nilai TOEFL,\n",
        "IPK, dan pengalaman kerja yang lebih tinggi cenderung diterima.\n",
        "\"\"\")\n",
        "\n",
        "# ==============================\n",
        "# C. VISUALISASI DATA\n",
        "# ==============================\n",
        "\n",
        "plt.figure(figsize=(8,5))\n",
        "sns.scatterplot(x='toefl', y='ipk', hue='diterima', data=df)\n",
        "plt.title(\"TOEFL vs IPK\")\n",
        "plt.show()\n",
        "\n",
        "plt.figure(figsize=(8,5))\n",
        "sns.scatterplot(x='pengalaman_kerja', y='toefl', hue='diterima', data=df)\n",
        "plt.title(\"Pengalaman Kerja vs TOEFL\")\n",
        "plt.show()\n",
        "\n",
        "# ==============================\n",
        "# D. CONFUSION MATRIX\n",
        "# ==============================\n",
        "\n",
        "# menentukan fitur dan target\n",
        "X = df[['toefl', 'ipk', 'pengalaman_kerja']]\n",
        "y = df['diterima']\n",
        "\n",
        "# split data\n",
        "X_train, X_test, y_train, y_test = train_test_split(\n",
        "    X, y, test_size=0.3, random_state=42\n",
        ")\n",
        "\n",
        "# model logistic regression\n",
        "model = LogisticRegression()\n",
        "\n",
        "# training model\n",
        "model.fit(X_train, y_train)\n",
        "\n",
        "# prediksi\n",
        "y_pred = model.predict(X_test)\n",
        "\n",
        "# confusion matrix\n",
        "cm = confusion_matrix(y_test, y_pred)\n",
        "\n",
        "# visualisasi confusion matrix\n",
        "plt.figure(figsize=(6,5))\n",
        "sns.heatmap(cm, annot=True, fmt='d', cmap='Blues')\n",
        "plt.xlabel(\"Predicted\")\n",
        "plt.ylabel(\"Actual\")\n",
        "plt.title(\"Confusion Matrix\")\n",
        "plt.show()\n",
        "\n",
        "# akurasi\n",
        "acc = accuracy_score(y_test, y_pred)\n",
        "\n",
        "print(\"Accuracy :\", acc)\n",
        "\n",
        "print(\"\"\"\n",
        "Penjelasan:\n",
        "Confusion matrix menunjukkan jumlah prediksi benar dan salah.\n",
        "Semakin besar nilai diagonal, maka model semakin baik.\n",
        "\"\"\")\n",
        "\n",
        "# ==============================\n",
        "# E. PLOT DATA\n",
        "# ==============================\n",
        "\n",
        "plt.figure(figsize=(8,5))\n",
        "sns.barplot(x='diterima', y='toefl', data=df)\n",
        "plt.title(\"Rata-rata TOEFL berdasarkan Status Diterima\")\n",
        "plt.show()\n",
        "\n",
        "# ==============================\n",
        "# F. PREDIKSI DATA BARU\n",
        "# ==============================\n",
        "\n",
        "# data pelamar baru\n",
        "pelamar_baru = pd.DataFrame({\n",
        "    'toefl': [590, 740, 680, 610, 710],\n",
        "    'ipk': [2.0, 3.07, 3.03, 2.03, 3.0],\n",
        "    'pengalaman_kerja': [3, 4, 6, 1, 5]\n",
        "})\n",
        "\n",
        "# prediksi\n",
        "hasil = model.predict(pelamar_baru)\n",
        "\n",
        "# tampilkan hasil\n",
        "pelamar_baru['prediksi_diterima'] = hasil\n",
        "\n",
        "print(\"\\nHASIL PREDIKSI\")\n",
        "print(pelamar_baru)"
      ]
    }
  ]
